<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/light_grey_1">

    <View
        android:id="@+id/posterPlaceholder"
        android:layout_width="90dp"
        android:layout_height="135dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/shimmer_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/titleLine1"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="@color/shimmer_placeholder"
        app:layout_constraintStart_toEndOf="@id/posterPlaceholder"
        app:layout_constraintTop_toTopOf="@id/posterPlaceholder"
        app:layout_constraintEnd_toStartOf="@id/bookPlaceholder" />

    <View
        android:id="@+id/titleLine2"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:background="@color/shimmer_placeholder"
        app:layout_constraintStart_toEndOf="@id/posterPlaceholder"
        app:layout_constraintTop_toBottomOf="@id/titleLine1"
        app:layout_constraintEnd_toStartOf="@id/bookPlaceholder" />

    <View
        android:id="@+id/datePlaceholder"
        android:layout_width="100dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@color/shimmer_placeholder"
        app:layout_constraintStart_toEndOf="@id/posterPlaceholder"
        app:layout_constraintTop_toBottomOf="@id/titleLine2" />

    <View
        android:id="@+id/adultsPlaceholder"
        android:layout_width="60dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:background="@color/shimmer_placeholder"
        app:layout_constraintStart_toEndOf="@id/posterPlaceholder"
        app:layout_constraintTop_toBottomOf="@id/datePlaceholder" />

    <View
        android:id="@+id/bookPlaceholder"
        android:layout_width="80dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:background="@color/shimmer_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/posterPlaceholder"
        app:layout_constraintBottom_toBottomOf="@id/posterPlaceholder" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/darker_gray"
        app:layout_constraintStart_toEndOf="@id/posterPlaceholder"
        app:layout_constraintTop_toBottomOf="@id/posterPlaceholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>